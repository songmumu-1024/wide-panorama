# 生成后端：mock（离线演示，不调用任何 API）| openai（OpenAI 兼容网关）
IMAGE_PROVIDER=mock

# 使用真实图片接口时填写
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1

# 题目给定的单次生成比例上限
MAX_SINGLE_RATIO=3
# 相邻段重叠比例（相对单段宽度），建议 0.12 ~ 0.20
OVERLAP_FRAC=0.15
DEFAULT_HEIGHT=1024

# 网关尺寸策略：auto（先试 WxH，失败回退白名单）| exact | preset
IMAGE_SIZE_MODE=auto
IMAGE_PRESET_SIZES=1536x1024,1024x1024,1024x1536
# 是否允许使用 /images/edits 做带 mask 的续画（质量最好）
IMAGE_ENABLE_EDITS=1

REQUEST_TIMEOUT=300
